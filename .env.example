# Copy this file to .env and fill local values.
# .env is intentionally ignored by git.

POSTGRES_DB=metadata_db
POSTGRES_USER=metadata_user
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

LINEAGE_APP_PORT=8080

# First UI user. Role is always data_engineer.
# If LINEAGE_ADMIN_PASSWORD is empty, the password is generated and printed
# to the application container logs on first startup.
LINEAGE_ADMIN_USERNAME=admin
LINEAGE_ADMIN_PASSWORD=

# File inside the application container where warehouse DSN passwords are
# persisted as environment variables. Docker Compose stores it in app_secrets volume.
LINEAGE_WAREHOUSE_ENV_FILE=/app/secrets/warehouse.env

# Optional external Docker network with warehouse PostgreSQL containers.
# Set it when the warehouse DB runs in another docker-compose project.
WAREHOUSE_DOCKER_NETWORK=diploma_test_db_default

# Optional. If set, this value has priority over POSTGRES_* fields.
# LINEAGE_DATABASE_URL=postgresql://metadata_user:change_me@localhost:5432/metadata_db
